/*
 * master_layers.dtsi — the single source of truth for layer content.
 *
 * Each layer is one KM_<layer> macro listing the 34 canonical master slots in a
 * fixed order, comma-separated (one macro argument per slot). A board's geometry
 * header (config/geometry/geom_<board>.h) provides the LAYOUT() adapter that
 * places these slots onto that board's physical matrix, dropping/padding as
 * needed. A board's <board>.keymap consumes them as `bindings = <LAYOUT(KM_base)>`.
 *
 * Canonical slot order (34 = pure 3x5 + 2-thumbs/side core):
 *      LT0 LT1 LT2 LT3 LT4 | RT4 RT3 RT2 RT1 RT0     row 0
 *      LM0 LM1 LM2 LM3 LM4 | RM4 RM3 RM2 RM1 RM0     row 1 (home)
 *      LB0 LB1 LB2 LB3 LB4 | RB4 RB3 RB2 RB1 RB0     row 2
 *              LH0 LH1     | RH1 RH0                 thumbs
 *
 * Content is the canonical TOTEM Colemak-DH layout (base, nav, num, fun, pad).
 * Optional slot groups (outer column, 3rd thumb, number row, center) are not yet
 * part of the master; they will be appended here when the first board that needs
 * them is migrated, leaving existing boards untouched.
 */

#pragma once

/*
 * Apply the active board's LAYOUT() adapter to a master layer macro:
 *   bindings = <KEYMAP_LAYER(KM_base)>;
 * The extra indirection forces KM_<layer> to expand to its comma-separated slot
 * list *before* LAYOUT() counts its arguments (C preprocessor argument prescan).
 */
#define KEYMAP_LAYER(...) LAYOUT(__VA_ARGS__)

/* clang-format off */

#define KM_base \
    &kp Q,        &kp W,         &kp F,          &kp P,          &kp B,       &kp J,        &kp L,          &kp U,          &kp Y,           &kp SEMI, \
    &hmg LGUI A,  &hmla LALT R,  &hmls LSHFT S,  &hmlc LCTRL T,  &kp G,       &kp M,        &hmrc RCTRL N,  &hmrs RSHFT E,  &hmla LALT I,    &hmg RGUI O, \
    &kp Z,        &hmra RALT X,  &kp C,          &kp D,          &kp V,       &kp K,        &kp H,          &kp COMMA,      &hmra RALT DOT,  &kp FSLH, \
    &mt LC(LS(LALT)) ESC,        &lt 1 RET,                      &lt 2 SPACE,                &mt LC(LS(LALT)) DEL

#define KM_nav \
    &kp ESC,      &kp PSCRN,        &kp UP,    &kp INS,    &kp PG_UP,    &bt BT_SEL 0,  &bt BT_SEL 1,  &bt BT_SEL 2,  &bt BT_SEL 3,  &bt BT_SEL 4, \
    &kp HOME,     &kp LEFT,         &kp DOWN,  &kp RIGHT,  &kp END,      &kp K_APP,     &kp RCTRL,     &kp RSHFT,     &kp LALT,      &kp RGUI, \
    &kp SLCK,     &kp PAUSE_BREAK,  &kp BSPC,  &kp DEL,    &kp PG_DN,    &none,         &bt BT_PRV,    &bt BT_NXT,    &kp RALT,      &bt BT_CLR, \
    &none,        &none,                                   &mo 3,                       &none

#define KM_num \
    &kp RS(N1),   &kp RS(N2),      &kp RS(N3),      &kp RS(N4),      &kp RS(N5),   &kp LS(N6),  &kp LS(N7),      &kp LS(N8),      &kp LS(N9),      &kp LS(N0), \
    &kp N1,       &hmla LALT N2,   &hmls LSHFT N3,  &hmlc LCTRL N4,  &kp N5,       &kp N6,      &hmrc RCTRL N7,  &hmrs RSHFT N8,  &hmla LALT N9,   &kp N0, \
    &MCR_DEGREE,  &hmra RALT SQT,  &kp BSPC,        &kp DEL,         &kp LBKT,     &kp RBKT,    &none,           &kp COMMA,       &hmra RALT DOT,  &none, \
    &none,        &tog 4,                                            &none,                     &none

#define KM_fun \
    &kp F1,       &kp F2,    &kp F3,     &kp F4,     &kp F5,      &kp F6,   &kp F7,     &kp F8,     &kp F9,    &kp F10, \
    &kp LGUI,     &kp LALT,  &kp LSHFT,  &kp LCTRL,  &kp F11,     &kp F12,  &kp RCTRL,  &kp RSHFT,  &kp LALT,  &kp RGUI, \
    &none,        &kp RALT,  &none,      &none,      &none,       &none,    &none,      &none,      &kp RALT,  &none, \
    &none,        &none,                              &none,                &none

#define KM_pad \
    &to 0,        &none,  &none,     &none,    &none,      &kp FSLH,   &kp N7,  &kp N8,  &kp N9,  &kp MINUS, \
    &none,        &none,  &none,     &none,    &none,      &kp STAR,   &kp N4,  &kp N5,  &kp N6,  &kp PLUS, \
    &none,        &none,  &kp BSPC,  &kp DEL,  &none,      &kp DOT,    &kp N1,  &kp N2,  &kp N3,  &kp COMMA, \
    &none,        &kp RET,                     &kp SPACE,              &kp N0

/* clang-format on */
