config BOARD_TIPPER_TF
    select SOC_NRF52840_QIAA
    select ZMK_BOARD_COMPAT if BOARD_TIPPER_TF_NRF52840_ZMK
    imply RETAINED_MEM if BOARD_TIPPER_TF_NRF52840_ZMK
    imply RETENTION if BOARD_TIPPER_TF_NRF52840_ZMK
    imply RETENTION_BOOT_MODE if BOARD_TIPPER_TF_NRF52840_ZMK
